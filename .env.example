# ASR
# tiny / base / small / medium / large-v3；演示用 small 起步，准确率不够再升 medium
ASR_MODEL=small
# auto 会优先尝试 cuda，失败自动回落 cpu
ASR_DEVICE=auto
# auto: cuda 用 float16，cpu 用 int8
ASR_COMPUTE_TYPE=auto
# 留空表示自动检测语种
ASR_LANGUAGE=zh

# VAD
VAD_FRAME_MS=30
VAD_START_RATIO=2.6
VAD_MIN_SPEECH_MS=300
VAD_HANGOVER_MS=600
VAD_MAX_SEGMENT_S=30

# 可选：LLM 后处理（留空即关闭，不影响主流程）
# 例：本地 vLLM -> http://localhost:8000/v1 ；Ollama -> http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
